[Unit]
Description=USB-Pasteur online signature update
Documentation=https://github.com/dbarzin/usb-pasteur/blob/main/docs/signatures.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# 1. Download the published set when it is newer (updates.url), as the only
#    user allowed out by the firewall, without privileges
User=usb-pasteur-update
Group=usb-pasteur-update
StateDirectory=usb-pasteur-update
StateDirectoryMode=0700
ExecStart=/usr/bin/usb-pasteur-signatures download --staging /var/lib/usb-pasteur-update/staging
# 2. Verify and install it, as root ("+": without the sandbox below). The
#    kiosk loads it when it is idle.
ExecStartPost=+/usr/bin/usb-pasteur-signatures install /var/lib/usb-pasteur-update/staging --staged
TimeoutStartSec=2h

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
