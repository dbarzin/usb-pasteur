[Unit]
Description=USB-Pasteur USB decontamination kiosk
Documentation=https://github.com/dbarzin/usb-pasteur
After=systemd-udevd.service local-fs.target
# clamd is started by its socket on the first connection
Wants=clamav-daemon.socket
After=clamav-daemon.socket
# The kiosk owns the first console
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
ExecStartPre=/usr/bin/usb-pasteur --check-config
ExecStart=/usr/bin/usb-pasteur
Restart=always
RestartSec=2

# Display the curses interface on tty1
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux

# Directories created by systemd
StateDirectory=usb-pasteur
StateDirectoryMode=0700
# Compiled YARA rules (engines.yara.cache_dir)
CacheDirectory=usb-pasteur
CacheDirectoryMode=0700
LogsDirectory=usb-pasteur
LogsDirectoryMode=0750

# Hardening. Mounting devices and starting the sandboxed scan workers
# (bubblewrap, then setpriv to scan.sandbox_user) require CAP_SYS_ADMIN, the
# capabilities to change user, and CAP_NET_ADMIN (bubblewrap brings up the
# loopback interface of the network namespace of the workers). The workers
# keep none of them.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/media/usb-pasteur
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# The scan workers get their own namespaces, but never a user namespace
RestrictNamespaces=mnt pid net ipc uts cgroup
RestrictRealtime=yes
# No RestrictSUIDSGID: its filter refuses openat2(), which bubblewrap needs.
# Setuid files cannot be created anyway: read-only root, /var and the devices
# mounted nosuid.
LockPersonality=yes
# No MemoryDenyWriteExecute: YARA-X compiles its rules to native code at run
# time (wasmtime) and fails with it, and the filter would also apply to the
# scan workers started by the kiosk. The workers are sandboxed instead.
SystemCallArchitectures=native
# Mounting the device needs the mount system calls
SystemCallFilter=@system-service @mount
SystemCallErrorNumber=EPERM
KeyringMode=private
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
