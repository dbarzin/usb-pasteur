#!/bin/sh
# Test profile: a signed test signature set (serial 1) installed like an
# update, and the matching configuration.
set -eu

CORPUS="$SRCDIR/usb-pasteur/image/vm/corpus.py"
PYTHON=/usr/lib/usb-pasteur/bin/python3

# Signature set detecting the corpus of the test key, signed with the
# development update key, then installed in /var/lib/usb-pasteur-signatures
SET=$(mktemp -d)
"$PYTHON" "$CORPUS" signatures "$SET"
usb-pasteur-signatures build "$SET" --serial 1 --key "$SRCDIR/usb-pasteur/image/update.key"
usb-pasteur-signatures install "$SET"
rm -r "$SET"

# Canary of the dm-verity test
"$PYTHON" "$CORPUS" canary /usr/share/usb-pasteur/verity-canary

cat > /etc/usb-pasteur/usb-pasteur.toml <<CONFIG
# Test profile configuration: the test signature set (image/vm/corpus.py),
# at the default paths but the YARA rules
[kiosk]
name = "vm-test"

[engines.yara]
rules = [{ name = "vm-test", path = "/var/lib/usb-pasteur-signatures/current/yara/vm-test/rules.yar" }]

[logging]
level = "DEBUG"

# Published by the virtual machine test (image/vm/run_tests.py) on the host
# of the QEMU user network
[updates]
enabled = true
url = "http://10.0.2.2:8080/usb-pasteur-signatures/"
image_url = "http://10.0.2.2:8080/usb-pasteur-image/"
CONFIG
