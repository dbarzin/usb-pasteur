# A/B update of the system image (usb_pasteur.imageupdate): the verity partition
# of the new version, staged by the kiosk from a verified image update, is
# written to the free slot. The running version is never overwritten.
[Transfer]
ProtectVersion=%A
# Verified by the kiosk (signed manifest); booted only if signed for Secure Boot
Verify=no

[Source]
Type=regular-file
Path=/var/lib/usb-pasteur-image/files
MatchPattern=usb-pasteur_@v_@u.verity.raw.xz

[Target]
Type=partition
Path=auto
MatchPattern=usb-pasteur_@v_verity
MatchPartitionType=root-verity
PartitionFlags=0
ReadOnly=1
